# Server Configuration
PORT=8080
ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=waap_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Direct Database URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waap_db?sslmode=disable

# JWT Secret
JWT_SECRET=supersecret-development-key-change-in-production

# Security & Limits
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_BODY_SIZE_BYTES=2097152
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
